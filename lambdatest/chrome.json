{
  "projectName": "klassijs Example Project",
  "build": "klassijs Example Project",
  "platform": "Windows 11",
  "browserName": "Chrome",
  "version": "latest-2",
  "webSocketUrl": true,
  "resolution": "1280x1024",
  "selenium_version": "4.13.0",
  "visual": true,
  "console": true,
  "chromeOptions": {
    "args": [
      "--use-fake-device-for-media-stream",
      "--use-fake-ui-for-media-stream",
      "--autoplay-policy=no-user-gesture-required",
      "--no-sandbox",
      "--disable-dev-shm-usage",
      "--disable-gpu",
      "--allow-file-access-from-files"
    ]
  }
}
